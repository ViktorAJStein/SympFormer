{
  "amp_dtype": "bfloat16",
  "arch": "causal_symp_pe",
  "batch_size": 8,
  "block_size": 256,
  "dataset": "tinystories",
  "eta_learnable": true,
  "eta_lin_init": 0.0001,
  "eta_log_init": 3.0,
  "eta_mode": "loglin",
  "eval_batches": 32,
  "eval_interval": 100,
  "grad_accum_steps": 16,
  "max_tokens": 100000000,
  "min_lr_ratio": 0.1,
  "muon_lr": 0.02,
  "n_embd": 256,
  "n_head": 4,
  "n_layer": 4,
  "no_v0_init": true,
  "optimizer": "muon_adamw",
  "peak_lr": 0.0006,
  "presymp_h": 0.1,
  "presymp_lnp": "end",
  "presymp_mlp_use_attn_vel": true,
  "require_data_manifest": true,
  "scalar_lr_mult": 5.0,
  "seed": 1337,
  "warmup_ratio": 0.1
